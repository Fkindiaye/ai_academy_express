/* Styles généraux */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #333;
}

a {
  text-decoration: none;
  color: #2c3e50;
}

/* En-tête */
header {
  background-color: #2c3e50;
  color: white;
  padding: 1rem;
  text-align: center;
}

.logo {
  display: block;
  margin: 0 auto 1rem auto;
}

.site-title {
  font-size: 2rem;
  margin-bottom: 1rem;
}

/* Navigation */
nav {
  display: flex;
  justify-content: center;
}

nav a {
  color: white;
  margin: 0 10px;
  padding: 5px 10px;
}

nav a:hover {
  text-decoration: underline;
}

/* Contenu principal */
main {
  max-width: 1200px;
  margin: 20px auto;
  padding: 0 20px;
}

h1 {
  margin-bottom: 1rem;
}

p {
  margin-bottom: 1.5rem;
}

/* Section des cours */
.courses {
  margin-top: 2rem;
}

h2 {
  margin-bottom: 1rem;
}

ul {
  list-style-type: disc;
  margin-left: 2rem;
}

li {
  margin-bottom: 0.5rem;
}

/* Pied de page */
footer {
  text-align: center;
  padding: 1rem;
  background-color: #f8f9fa;
  margin-top: 2rem;
}