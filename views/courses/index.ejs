<h2>Liste des cours</h2>

<% if (courses && courses.length > 0) { %>
  <table class="table">
    <thead>
      <tr>
        <th>Titre</th>
        <th>Description</th>
        <th>Coût</th>
        <th>Nb Max Étudiants</th>
        <th>Modifier</th>
        <th>Supprimer</th>
      </tr>
    </thead>
    <tbody>
      <% courses.forEach(course => { %>
        <tr>
          <td>
            <a href="/courses/<%= course._id %>">
              <%= course.title %>
            </a>
          </td>
          <td><%= course.description %></td>
          <td><%= course.cost %> €</td>
          <td><%= course.maxStudents %></td>
          <td>
            <a href="/courses/<%= course._id %>/edit" class="btn btn-info">Modifier</a>
          </td>
          <td>
            <form action="/courses/<%= course._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce cours?');">
              <button type="submit" class="btn btn-danger">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <p>Aucun cours disponible pour le moment.</p>
<% } %>

<a href="/courses/new" class="btn btn-primary">Créer un nouveau cours</a>
